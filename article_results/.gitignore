# Ignore generated artifacts by default.
sampling_runs/**
analysis_runs/**
figures/**
exports/**
notebooks/**
!notebooks/
!notebooks/*.ipynb
notebooks/*.local.ipynb
RUN_TRACKER.md

# Keep directory structure and human-written metadata.
!sampling_runs/
!sampling_runs/**/
!sampling_runs/**/.gitkeep
!sampling_runs/**/README.md
!sampling_runs/**/manifest.yaml

!analysis_runs/
!analysis_runs/**/
!analysis_runs/**/.gitkeep
!analysis_runs/**/README.md
!analysis_runs/**/metrics_schema.md
!analysis_runs/**/_fold_vs_native_groups.py
!analysis_runs/**/*.summary.json

!figures/
!figures/**/
!figures/**/.gitkeep
!figures/**/README.md

# Manifests and curated external baselines are lightweight and should be tracked.
!manifests/**
!summary_tables/**
!external_baselines/**

# Common heavy outputs.
*.csv
*.pdb
*.cif
*.bcif
*.pt
*.ckpt
*.npz
*.npy
*.fa
*.fasta
*.jsonl
*.tsv
*.dbtype
*.index
*.lookup
*.source
*.tmp
tmp*/
esmfold/
foldseek_tmp/
designable_samples*/
consistent_samples*/
precise_samples*/
*_clusters/
